{
  "name": "furygym",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,edge-runtime,storage-api,realtime,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "pnpm --filter @furygym/db-tests test",
    "web:dev": "pnpm --filter @furygym/web dev",
    "web:build": "pnpm --filter @furygym/web build",
    "web:test": "pnpm --filter @furygym/web test",
    "web:e2e": "pnpm --filter @furygym/web e2e"
  },
  "devDependencies": {
    "supabase": "^2.0.0"
  }
}
