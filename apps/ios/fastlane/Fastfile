# Release lanes for the Fury Co. iOS app.
#
# NOT YET EXERCISED: these lanes need Fury Co.'s Apple Developer account and could not be run
# while the app was being built. Expect to adjust signing details on the first real run.
# See docs/launch-checklist.md for the one-time setup.
#
# Required environment (set locally or as GitHub Actions secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8   App Store Connect API key (App Manager role or higher)
#   DEVELOPMENT_TEAM                        10-character Apple team ID
#   APP_BUNDLE_ID                           e.g. com.furyco.athletics
#   SUPABASE_URL, SUPABASE_ANON_KEY, WEB_BASE_URL   production backend the build should talk to

default_platform(:ios)

platform :ios do
  before_all do
    Dir.chdir("..") do
      # Production settings for this build. URLs use $() because xcconfig treats // as a comment.
      escape = ->(url) { url.to_s.sub("//", "/$()/") }
      File.write("Config/Config.xcconfig", <<~XCCONFIG)
        DEVELOPMENT_TEAM = #{ENV.fetch("DEVELOPMENT_TEAM")}
        APP_BUNDLE_ID = #{ENV.fetch("APP_BUNDLE_ID", "com.furyco.athletics")}
        SUPABASE_URL = #{escape.call(ENV.fetch("SUPABASE_URL"))}
        SUPABASE_ANON_KEY = #{ENV.fetch("SUPABASE_ANON_KEY")}
        WEB_BASE_URL = #{escape.call(ENV.fetch("WEB_BASE_URL"))}
      XCCONFIG
      sh("xcodegen generate")
    end
  end

  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      in_house: false
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    key = api_key
    # Build numbers must increase with every upload.
    increment_build_number(
      xcodeproj: "FuryCo.xcodeproj",
      build_number: (latest_testflight_build_number(api_key: key, initial_build_number: 0) + 1).to_s
    )
    build_app(
      project: "FuryCo.xcodeproj",
      scheme: "FuryCo",
      export_method: "app-store",
      # Lets Xcode create and renew signing certificates and profiles using the API key.
      xcargs: "-allowProvisioningUpdates -skipMacroValidation -skipPackagePluginValidation",
      export_options: { signingStyle: "automatic" }
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Submit the latest TestFlight build for App Store review (does not release automatically)"
  lane :release do
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
